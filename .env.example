# Health Tracker — copy this to .env and fill in your credentials
# Never commit .env to git

# Oura Ring
# Get your personal access token at: https://cloud.ouraring.com/personal-access-tokens
OURA_TOKEN=your_oura_token_here

# Wyze Scale (unofficial API)
WYZE_EMAIL=your_wyze_email@example.com
WYZE_PASSWORD=your_wyze_password_here

# Insight Timer
# Export your data from the app: Profile → Settings → Account → Download your data
# Unzip the file and find sessions.csv, then put the path here
INSIGHT_TIMER_CSV=/path/to/insight_timer_sessions.csv
